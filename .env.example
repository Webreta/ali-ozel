# Kopyala: .env.local (dev) / VPS'te compose env dosyası
DATABASE_URL=postgres://aliozel:devpassword@localhost:5432/aliozel
# 32+ byte rastgele: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Dev'de proje içi klasör; prod'da /data/uploads (Docker volume)
UPLOAD_DIR=./.uploads
# İlk admin kullanıcısı (db:seed ile oluşturulur)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://aliozel.com.tr
# Teklif/iletişim bildirimi (opsiyonel — boşsa mail atlanır, form yine çalışır)
RESEND_API_KEY=
NOTIFY_TO=ali@aliozel.com.tr
# Resend'de domain doğrulanınca kendi adresinizle değiştirin
NOTIFY_FROM=Aliozel Site <onboarding@resend.dev>
